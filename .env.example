# Copy to .env and fill in. Never commit .env — it holds your wallet's private key.
# Use a fresh wallet that only holds free testnet BNB.
PRIVATE_KEY=
# Optional: custom RPC (defaults to the public BNB testnet endpoint)
BSC_TESTNET_RPC=
# Optional: wallet that receives the 2% fee (defaults to the deployer)
FEE_RECIPIENT=
# Optional: an existing token instead of deploying Test USDT
# (BSC mainnet USDT is 0x55d398326f99059fF775485246999027B3197955)
TOKEN_ADDRESS=
